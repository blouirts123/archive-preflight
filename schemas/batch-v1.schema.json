{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Archive Preflight batch v1",
  "description": "The v1 JSON envelope emitted when multiple archives are checked or batch mode is requested.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "batch"
    },
    "ok": {
      "type": "boolean"
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/result"
      }
    }
  },
  "required": ["schema_version", "kind", "ok", "results"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {"ok": {"const": true}},
        "required": ["ok"]
      },
      "then": {
        "properties": {
          "results": {
            "items": {
              "properties": {
                "report": {
                  "properties": {"ok": {"const": true}},
                  "required": ["ok"]
                }
              },
              "required": ["report"]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"ok": {"const": false}},
        "required": ["ok"]
      },
      "then": {
        "properties": {
          "results": {
            "contains": {
              "anyOf": [
                {"required": ["error"]},
                {
                  "properties": {
                    "report": {
                      "properties": {"ok": {"const": false}},
                      "required": ["ok"]
                    }
                  },
                  "required": ["report"]
                }
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "result": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "archive": {
              "type": "string"
            },
            "report": {
              "$ref": "./report-v1.schema.json"
            }
          },
          "required": ["archive", "report"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "archive": {
              "type": "string"
            },
            "error": {
              "type": "string"
            }
          },
          "required": ["archive", "error"],
          "additionalProperties": false
        }
      ]
    }
  }
}
