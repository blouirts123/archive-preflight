{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Archive Preflight report v1",
  "description": "The exact single-archive report returned by the v1 JSON interface.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "format": {
      "type": "string",
      "enum": ["zip", "tar"]
    },
    "member_count": {
      "type": "integer",
      "minimum": 0
    },
    "total_size": {
      "type": "integer",
      "minimum": 0
    },
    "complete": {
      "type": "boolean"
    },
    "ok": {
      "type": "boolean"
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    }
  },
  "required": [
    "schema_version",
    "format",
    "member_count",
    "total_size",
    "complete",
    "ok",
    "findings"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {"ok": {"const": true}},
        "required": ["ok"]
      },
      "then": {
        "properties": {
          "complete": {"const": true},
          "findings": {"maxItems": 0}
        }
      }
    },
    {
      "if": {
        "properties": {"complete": {"const": false}},
        "required": ["complete"]
      },
      "then": {"properties": {"ok": {"const": false}}}
    },
    {
      "if": {
        "properties": {"findings": {"minItems": 1}},
        "required": ["findings"]
      },
      "then": {"properties": {"ok": {"const": false}}}
    },
    {
      "if": {
        "properties": {
          "complete": {"const": true},
          "findings": {"maxItems": 0}
        },
        "required": ["complete", "findings"]
      },
      "then": {"properties": {"ok": {"const": true}}}
    }
  ],
  "$defs": {
    "finding": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "description": "Stable machine-readable finding identifier; values may be added in compatible releases."
        },
        "member": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": ["code", "member", "message"],
      "additionalProperties": false
    }
  }
}
